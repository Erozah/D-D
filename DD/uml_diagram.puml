@startuml

' Interfaces
interface CellContent {
  + interact(): String
  + interact(character: Character): String
  + getName(): String
}

interface Dice {
  + roll(): int
}

' Classes abstraites
abstract class Character {
  - type: String
  - name: String
  - healthPoints: int
  - attackPower: int
  - offensiveEquipment: OffensiveEquipment
  - defensiveEquipment: DefensiveEquipment
  + getType(): String
  + setType(type: String): void
  + getName(): String
  + setName(name: String): void
  + getHealthPoints(): int
  + setHealthPoints(healthPoints: int): void
  + getAttackPower(): int
  + setAttackPower(attackPower: int): void
  + getOffensiveEquipment(): OffensiveEquipment
  + setOffensiveEquipment(offensiveEquipment: OffensiveEquipment): void
  + getDefensiveEquipment(): DefensiveEquipment
  + setDefensiveEquipment(defensiveEquipment: DefensiveEquipment): void
  + toString(): String
}

abstract class OffensiveEquipment {
  - equipmentType: String
  - attackPower: int
  - name: String
  + getEquipmentType(): String
  + setEquipmentType(equipmentType: String): void
  + getAttackPower(): int
  + setAttackPower(attackPower: int): void
  + getName(): String
  + setName(name: String): void
  + toString(): String
}

abstract class DefensiveEquipment {
  - equipmentType: String
  - name: String
  - defensePoints: int
  + getEquipmentType(): String
  + setEquipmentType(equipmentType: String): void
  + getName(): String
  + setName(name: String): void
  + getDefensePoints(): int
  + setDefensePoints(defensePoints: int): void
  + toString(): String
}

' Classes concrètes - Personnages
class Warrior {
  + Warrior(type: String, name: String)
  + toString(): String
}

class Wizard {
  + Wizard(type: String, name: String)
  + toString(): String
}

' Classes concrètes - Ennemis
class Enemy {
  - isBoss: boolean
  + Enemy(type: String, name: String, healthPoints: int, attackPower: int,
          offensiveEquipment: OffensiveEquipment, defensiveEquipment: DefensiveEquipment, isBoss: boolean)
  + isBoss(): boolean
  + interact(): String
  + interact(character: Character): String
  + getName(): String
  + defeat(): OffensiveEquipment
}

class Dragon {
  + Dragon(name: String)
  + Dragon(name: String, healthPoints: int, attackPower: int)
  + interact(): String
  + interact(character: Character): String
  + getName(): String
}

class Goblin {
  + Goblin(name: String)
  + Goblin(name: String, healthPoints: int, attackPower: int)
  + interact(): String
  + interact(character: Character): String
}

class Orc {
  + Orc(name: String)
  + Orc(name: String, healthPoints: int, attackPower: int)
  + interact(): String
  + interact(character: Character): String
}

class Sorcerer {
  + Sorcerer(name: String)
  + Sorcerer(name: String, healthPoints: int, attackPower: int)
  + interact(): String
  + interact(character: Character): String
}

' Classes concrètes - Équipements
class Weapon {
  + Weapon(weaponType: String, name: String, weaponDamage: int)
  + toString(): String
  + interact(): String
  + interact(character: Character): String
  + getName(): String
}

class Spell {
  + Spell(spellType: String, name: String, spellDamage: int)
  + toString(): String
  + interact(): String
  + interact(character: Character): String
  + getName(): String
}

class Shield {
  + Shield(shieldType: String, name: String, defensePoints: int)
  + toString(): String
  + interact(): String
  + interact(character: Character): String
  + getName(): String
}

class Potion {
  + Potion(potionType: String, name: String, defensePoints: int)
  + toString(): String
  + interact(): String
  + interact(character: Character): String
  + getName(): String
}

' Classes concrètes - Plateau
class Cell {
  - content: CellContent
  + Cell()
  + Cell(content: CellContent)
  + getContent(): CellContent
  + setContent(content: CellContent): void
  + isEmpty(): boolean
  + interact(character: Character): String
  + interact(): String
  + toString(): String
}

class MysteryBox {
  - content: CellContent
  + MysteryBox(content: CellContent)
  + getContent(): CellContent
  + interact(): String
  + interact(character: Character): String
  + getName(): String
  + toString(): String
}

class Board {
  - currentPosition: int
  - MAX_POSITION: int
  - cells: List<Cell>
  + Board()
  + Board(size: int)
  + initializeBoard(): void
  + getCurrentPosition(): int
  + setCurrentPosition(currentPosition: int): void
  + getMaxPosition(): int
  + getCurrentCell(): Cell
  + getCell(position: int): Cell
  + setCellContent(position: int, content: CellContent): void
  + toString(): String
}

' Classes concrètes - Logique de jeu
class SixSidedDice {
  + roll(): int
  + toString(): String
}

class TwentySidedDice {
  + roll(): int
  + toString(): String
}

class Game {
  - player: Character
  - board: Board
  - gameOver: boolean
  - menu: Menu
  + setPlayer(player: Character): void
  + getPlayer(): Character
  + displayTitle(): void
  + mainMenu(): void
  + showCharacterStats(): void
  + createCharacter(): void
  + playTurn(board: Board, dice: Dice): void
  + endGame(): void
  + start(): void
  + toString(): String
}

class Menu {
  - scanner: Scanner
  - INNER_WIDTH: int
  - BORDER: String
  + askPlayerString(textMessage: String...): String
  + printCenteredLine(textMessage: String): void
  + beforeLine(): void
  + afterLine(): void
  + toString(): String
}

class OutOfBoardException {
  + OutOfBoardException(message: String)
}

' Relations d'héritage
Character <|-- Warrior
Character <|-- Wizard
Character <|-- Enemy
Enemy <|-- Dragon
Enemy <|-- Goblin
Enemy <|-- Orc
Enemy <|-- Sorcerer
OffensiveEquipment <|-- Weapon
OffensiveEquipment <|-- Spell
DefensiveEquipment <|-- Shield
DefensiveEquipment <|-- Potion

' Relations d'implémentation
CellContent <|.. Enemy
CellContent <|.. Weapon
CellContent <|.. Spell
CellContent <|.. Shield
CellContent <|.. Potion
CellContent <|.. MysteryBox
Dice <|.. SixSidedDice
Dice <|.. TwentySidedDice
Exception <|-- OutOfBoardException

' Relations d'association
Game --> Board
Game --> Dice
Game --> Menu
Game --> Character
Board o-- Cell
Character --> OffensiveEquipment
Character --> DefensiveEquipment
Cell --> CellContent
MysteryBox --> CellContent

@enduml